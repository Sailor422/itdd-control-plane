{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ITDD verification contract","type":"object","additionalProperties":false,"required":["verification_contract_id","schema_version","version","project_id","execution_id","role","intent_id","intent_version","graph_id","graph_version","eu_id","baseline_sha","candidate_sha","context_packet_id","context_packet_hash","required_checks","required_artifacts","allowed_changed_paths","created_at","created_by","contract_hash"],"properties":{"verification_contract_id":{"type":"string","pattern":"^VC-[0-9]+$"},"schema_version":{"const":1},"version":{"type":"integer","minimum":1},"project_id":{"type":"string"},"execution_id":{"type":"string"},"role":{"type":"string"},"intent_id":{"type":"string"},"intent_version":{"type":"integer","minimum":1},"graph_id":{"type":"string"},"graph_version":{"type":"integer","minimum":1},"eu_id":{"type":"string"},"baseline_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"candidate_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"context_packet_id":{"type":"string"},"context_packet_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"required_checks":{"type":"array"},"required_artifacts":{"type":"array"},"allowed_changed_paths":{"type":"array","items":{"type":"string"}},"created_at":{"type":"string"},"created_by":{"type":"string"},"contract_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
