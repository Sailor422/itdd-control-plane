{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdd-control-plane.dev/schemas/intent.schema.json",
  "title": "ITDD Control Plane Stage C Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_id", "version", "status", "created_at", "created_by", "project_id", "title", "purpose", "requirements", "constraints", "acceptance_summary", "source_event_id", "schema_version"],
  "properties": {
    "intent_id": {"type": "string", "pattern": "^I-[0-9]+$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "APPROVED", "SUPERSEDED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "text"], "properties": {"requirement_id": {"type": "string", "pattern": "^REQ-[0-9]+$"}, "text": {"type": "string", "minLength": 1}}}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "acceptance_summary": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "approved_by": {"type": "string"},
    "approved_at": {"type": "string", "format": "date-time"},
    "approval_event_id": {"type": "string"}
  }
}

