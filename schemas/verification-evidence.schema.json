{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ITDD verification evidence","type":"object","additionalProperties":false,"required":["evidence_id","schema_version","version","verification_contract_id","project_id","execution_id","role","intent_id","intent_version","graph_id","graph_version","eu_id","baseline_sha","candidate_sha","context_packet_id","context_packet_hash","check_results","artifact_hashes","observed_changed_paths","created_at","created_by","evidence_hash"],"properties":{"evidence_id":{"type":"string","pattern":"^EV-[0-9]+$"},"schema_version":{"const":1},"version":{"type":"integer","minimum":1},"verification_contract_id":{"type":"string"},"project_id":{"type":"string"},"execution_id":{"type":"string"},"role":{"type":"string"},"intent_id":{"type":"string"},"intent_version":{"type":"integer","minimum":1},"graph_id":{"type":"string"},"graph_version":{"type":"integer","minimum":1},"eu_id":{"type":"string"},"baseline_sha":{"type":"string"},"candidate_sha":{"type":"string"},"context_packet_id":{"type":"string"},"context_packet_hash":{"type":"string"},"check_results":{"type":"array"},"artifact_hashes":{"type":"object"},"observed_changed_paths":{"type":"array"},"created_at":{"type":"string"},"created_by":{"type":"string"},"evidence_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
