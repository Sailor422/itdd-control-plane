{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdd-control-plane.dev/schemas/human-gate.schema.json",
  "title": "ITDD human gate", "type": "object", "additionalProperties": false,
  "required": ["gate_id", "schema_version", "project_id", "gate_type", "subject_type", "subject_id", "required_state", "created_at", "status", "decision_event_id", "related_intent", "related_graph", "related_eu", "related_candidate", "evidence", "approval_capability_id"],
  "properties": {
    "gate_id": {"type": "string", "pattern": "^HG-[0-9]{3,}$"}, "schema_version": {"const": 1}, "project_id": {"type": "string"}, "gate_type": {"type": "string"}, "subject_type": {"type": "string"}, "subject_id": {"type": "string"}, "required_state": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "status": {"enum": ["WAITING", "APPROVED", "REJECTED", "SUPERSEDED", "CANCELLED"]}, "decision_event_id": {"type": ["string", "null"]}, "related_intent": {"type": ["object", "null"]}, "related_graph": {"type": ["object", "null"]}, "related_eu": {"type": ["object", "null"]}, "related_candidate": {"type": "object"}, "evidence": {"type": "object"}, "approval_capability_id": {"type": "string"}, "superseded_by": {"type": "object", "required": ["amendment_id", "amendment_version"], "additionalProperties": false}
  }
}
